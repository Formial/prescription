<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Formial Labs — Prescription Generator</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --teal-dark: #1a4a42;
    --teal-mid:  #2d7a6f;
    --teal-light:#4aab9c;
    --sand:      #e8dcc8;
    --sand-light:#f5f0e8;
    --cream:     #fdfaf5;
    --ink:       #1c2220;
    --muted:     #6b7c78;
    --white:     #ffffff;
    --radius:    12px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--ink);
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 20px 60px;
  }

  .container {
    width: 100%;
    max-width: 780px;
  }

  /* ── Header ── */
  .header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
  }
  .header-logo {
    background: var(--teal-dark);
    color: var(--white);
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    letter-spacing: 2px;
    padding: 10px 18px;
    border-radius: 8px;
  }
  .header-logo span { color: var(--teal-light); }
  .header-text h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 22px;
    color: var(--teal-dark);
    font-weight: 400;
  }
  .header-text p {
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
  }

  /* ── Card ── */
  .card {
    background: var(--white);
    border-radius: var(--radius);
    border: 1px solid rgba(0,0,0,0.07);
    box-shadow: 0 2px 20px rgba(26,74,66,0.06);
    padding: 36px 40px;
    margin-bottom: 20px;
  }
  .card-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--teal-mid);
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--sand);
  }

  /* ── Form ── */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 28px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-group.full { grid-column: 1 / -1; }

  label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--muted);
  }
  input, select, textarea {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: var(--ink);
    background: var(--sand-light);
    border: 1.5px solid transparent;
    border-radius: 8px;
    padding: 10px 14px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 100%;
  }
  input:focus, select:focus, textarea:focus {
    border-color: var(--teal-light);
    box-shadow: 0 0 0 3px rgba(74,171,156,0.15);
    background: var(--white);
  }
  textarea { resize: vertical; min-height: 100px; line-height: 1.6; }
  select { cursor: pointer; }

  /* medicine rows */
  #medicine-rows { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
  .med-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
  }
  .med-row input { margin: 0; }
  .btn-remove-med {
    background: none;
    border: 1.5px solid #ddd;
    border-radius: 6px;
    color: #999;
    width: 34px; height: 34px;
    cursor: pointer;
    font-size: 16px;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s;
  }
  .btn-remove-med:hover { border-color: #e05; color: #e05; }
  .btn-add-med {
    background: none;
    border: 1.5px dashed var(--teal-light);
    border-radius: 8px;
    color: var(--teal-mid);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    cursor: pointer;
    transition: all 0.2s;
    width: 100%;
  }
  .btn-add-med:hover { background: rgba(74,171,156,0.08); }

  /* ── Generate button ── */
  .btn-generate {
    width: 100%;
    padding: 16px;
    background: var(--teal-dark);
    color: var(--white);
    border: none;
    border-radius: var(--radius);
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }
  .btn-generate:hover { background: var(--teal-mid); }
  .btn-generate:active { transform: scale(0.99); }
  .btn-generate svg { width: 18px; height: 18px; }

  /* ── Preview strip ── */
  .preview-strip {
    background: var(--sand-light);
    border: 1px solid var(--sand);
    border-radius: var(--radius);
    padding: 20px 28px;
    font-size: 13px;
    color: var(--muted);
    display: none;
  }
  .preview-strip.visible { display: block; }
  .preview-strip strong { color: var(--ink); }

  /* toast */
  #toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: var(--teal-dark);
    color: var(--white);
    padding: 12px 24px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 500;
    transition: transform 0.3s ease;
    z-index: 999;
    pointer-events: none;
  }
  #toast.show { transform: translateX(-50%) translateY(0); }
</style>
</head>
<body>

<div class="container">

  <div class="header">
    <div class="header-logo">form<span>ial</span></div>
    <div class="header-text">
      <h1>Prescription Generator</h1>
      <p>Dr. Neha Fogla · MBBS MD (Derm) · MMC Reg. 2021054683</p>
    </div>
  </div>

  <!-- Patient Details -->
  <div class="card">
    <div class="card-title">Patient Details</div>
    <div class="form-grid">
      <div class="form-group">
        <label>Patient Name</label>
        <input type="text" id="patientName" placeholder="e.g. Prachi Redkar" />
      </div>
      <div class="form-group">
        <label>Gender</label>
        <select id="gender">
          <option value="">Select</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label>Age</label>
        <input type="text" id="age" placeholder="e.g. 26" />
      </div>
      <div class="form-group">
        <label>Date of Prescription</label>
        <input type="date" id="rxDate" />
      </div>
    </div>
  </div>

  <!-- Prescription -->
  <div class="card">
    <div class="card-title">Prescription / Medicines</div>
    <div id="medicine-rows">
      <div class="med-row">
        <input type="text" placeholder="e.g. Cap Sotret 10 mg once daily after lunch for 4 weeks" />
        <button class="btn-remove-med" onclick="removeMed(this)" title="Remove">×</button>
      </div>
    </div>
    <button class="btn-add-med" onclick="addMed()">+ Add medicine / instruction</button>
  </div>

  <!-- Optional notes -->
  <div class="card">
    <div class="card-title">Additional Notes <span style="font-weight:300;text-transform:none;letter-spacing:0">(optional)</span></div>
    <div class="form-group">
      <textarea id="notes" placeholder="Follow-up in 4 weeks, avoid sun exposure, etc."></textarea>
    </div>
  </div>

  <button class="btn-generate" onclick="generatePDF()">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
    Generate &amp; Download Prescription PDF
  </button>

</div>

<div id="toast">✓ Prescription downloaded!</div>

<script>
// ── constants ──────────────────────────────────────────────
const DR = {
  name:       'Dr. Neha Fogla',
  degree:     'MBBS, MD (DVL)',
  regLabel:   'MMC Reg. No.',
  regNo:      '2021054683',
  address:    '1st Floor, 181, Kbar Road, Austin Town, Bangalore – 560047',
  phone:      '+91 87928 08844',
  email:      'care@formial.in',
  brand:      'formial',
  brandSub:   'LABS',
};

// ── medicine rows ──────────────────────────────────────────
function addMed() {
  const row = document.createElement('div');
  row.className = 'med-row';
  row.innerHTML = `<input type="text" placeholder="Medicine / instruction line" /><button class="btn-remove-med" onclick="removeMed(this)" title="Remove">×</button>`;
  document.getElementById('medicine-rows').appendChild(row);
}
function removeMed(btn) {
  const rows = document.querySelectorAll('.med-row');
  if (rows.length === 1) { btn.closest('.med-row').querySelector('input').value = ''; return; }
  btn.closest('.med-row').remove();
}

// ── set today as default date ──────────────────────────────
document.getElementById('rxDate').valueAsDate = new Date();

// ── PDF generation ─────────────────────────────────────────
function generatePDF() {
  const name    = document.getElementById('patientName').value.trim();
  const age     = document.getElementById('age').value.trim();
  const gender  = document.getElementById('gender').value;
  const dateVal = document.getElementById('rxDate').value;
  const notes   = document.getElementById('notes').value.trim();

  const meds = [...document.querySelectorAll('#medicine-rows .med-row input')]
    .map(i => i.value.trim()).filter(Boolean);

  if (!name) { alert('Please enter the patient name.'); return; }
  if (!dateVal) { alert('Please select a date.'); return; }
  if (meds.length === 0) { alert('Please enter at least one medicine / instruction.'); return; }

  // format date  DD-MM-YYYY
  const [y, m, d] = dateVal.split('-');
  const displayDate = `${d}-${m}-${y}`;

  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'mm', format: 'a4' });

  const W = 210, H = 297;
  const PL = 18, PR = 18; // page margins
  const CW = W - PL - PR;

  // ── colour helpers ──────────────────────────────────────
  const tealDark  = [26, 74, 66];
  const tealLight = [74, 171, 156];
  const sand      = [232, 220, 200];
  const sandLight = [245, 240, 232];
  const ink       = [28, 34, 32];
  const muted     = [107, 124, 120];
  const white     = [255, 255, 255];

  // ── TOP DECORATIVE HEADER BAND ──────────────────────────
  // large teal triangle top-left
  doc.setFillColor(...tealDark);
  doc.triangle(0, 0, 68, 0, 0, 34, 'F');

  // sand accent strip overlapping
  doc.setFillColor(...sand);
  doc.triangle(14, 0, 80, 0, 14, 28, 'F');

  // formial brand block top-right
  const bx = W - 52, by = 6, bw = 46, bh = 24;
  doc.setFillColor(...sandLight);
  doc.roundedRect(bx, by, bw, bh, 3, 3, 'F');
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(14);
  doc.setTextColor(...tealDark);
  doc.text('formial', bx + bw/2, by + 11, { align: 'center' });
  doc.setFontSize(6.5);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(...tealLight);
  doc.text('LABS', bx + bw/2, by + 17, { align: 'center' });

  // ── DOCTOR NAME BLOCK ───────────────────────────────────
  let cy = 42;
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(17);
  doc.setTextColor(...tealDark);
  doc.text(DR.name.toUpperCase(), PL, cy);

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(9.5);
  doc.setTextColor(...muted);
  cy += 6;
  doc.text(DR.degree, PL, cy);
  cy += 5;
  doc.text(`${DR.regLabel} ${DR.regNo}`, PL, cy);

  // thin teal rule
  cy += 6;
  doc.setDrawColor(...tealLight);
  doc.setLineWidth(0.5);
  doc.line(PL, cy, W - PR, cy);
  cy += 1;

  // ── Rx symbol + patient details row ────────────────────
  cy += 8;
  // Rx symbol
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(22);
  doc.setTextColor(...tealDark);
  doc.text('Rx', PL, cy);

  // Patient info right side
  doc.setFontSize(9);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(...muted);
  const rightX = W - PR;
  doc.text('Date', rightX - 42, cy - 4, { align: 'left' });
  doc.setTextColor(...ink);
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(9.5);
  doc.text(displayDate, rightX, cy - 4, { align: 'right' });

  // patient name line
  cy += 7;
  doc.setFontSize(9);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(...muted);
  doc.text('Patient', PL + 14, cy);
  doc.setTextColor(...ink);
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(10.5);
  doc.text(name, PL + 36, cy);

  // age / gender
  const ageParts = [age && `Age: ${age}`, gender && `Gender: ${gender}`].filter(Boolean);
  if (ageParts.length) {
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9);
    doc.setTextColor(...muted);
    doc.text(ageParts.join('   ·   '), PL + 36, cy + 5.5);
  }

  // ── separator with Rx mark ──────────────────────────────
  cy += 16;
  doc.setDrawColor(...sand);
  doc.setLineWidth(0.4);
  doc.line(PL, cy, W - PR, cy);

  // ── MEDICINES ───────────────────────────────────────────
  cy += 10;
  meds.forEach((med, idx) => {
    // bullet
    doc.setFillColor(...tealLight);
    doc.circle(PL + 2, cy - 1.5, 1.2, 'F');

    // number
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    doc.setTextColor(...tealDark);
    doc.text(`${idx + 1}.`, PL + 6, cy);

    // text — wrap long lines
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.setTextColor(...ink);
    const lines = doc.splitTextToSize(med, CW - 16);
    doc.text(lines, PL + 14, cy);
    cy += lines.length * 6.2 + 4;
  });

  // ── NOTES ───────────────────────────────────────────────
  if (notes) {
    cy += 4;
    doc.setFillColor(...sandLight);
    const noteLines = doc.splitTextToSize(notes, CW - 16);
    const noteH = noteLines.length * 5.5 + 12;
    doc.roundedRect(PL, cy, CW, noteH, 3, 3, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(8);
    doc.setTextColor(...tealMid || tealDark);
    doc.text('NOTES', PL + 8, cy + 7);
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9.5);
    doc.setTextColor(...ink);
    doc.text(noteLines, PL + 8, cy + 13);
    cy += noteH + 6;
  }

  // ── SIGNATURE ───────────────────────────────────────────
  // Place near bottom but above footer; reserve 55mm for sig block
  const sigY = Math.max(cy + 14, H - 80);

  // Signature — draw as SVG-like path approximating the original handwriting
  drawSignature(doc, PL, sigY, tealDark);

  // printed name below sig
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(10);
  doc.setTextColor(...tealDark);
  doc.text(DR.name, PL, sigY + 22);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(8.5);
  doc.setTextColor(...muted);
  doc.text(DR.degree, PL, sigY + 27.5);

  // ── FOOTER BAND ─────────────────────────────────────────
  const footerY = H - 24;

  // sand background strip
  doc.setFillColor(...sandLight);
  doc.rect(0, footerY, W, 24, 'F');

  // teal accent bottom-right corner triangle
  doc.setFillColor(...tealDark);
  doc.triangle(W - 40, H, W, H - 28, W, H, 'F');

  // sand smaller triangle
  doc.setFillColor(...sand);
  doc.triangle(W - 20, H, W, H - 14, W, H, 'F');

  doc.setFontSize(7.5);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(...muted);
  doc.text(`REG OFFICE: ${DR.address.toUpperCase()}`, PL, footerY + 8);
  doc.text(`${DR.phone}`, PL, footerY + 14);
  doc.text(DR.email, PL, footerY + 20);

  // ── SAVE ────────────────────────────────────────────────
  const safeName = name.replace(/\s+/g, '_');
  doc.save(`Prescription_${safeName}_${displayDate.replace(/-/g,'')}.pdf`);
  showToast();
}

// ── Signature drawing (approximated from the PDF scan) ──
function drawSignature(doc, x, y, color) {
  doc.setDrawColor(...color);
  doc.setLineWidth(0.6);

  // A stylised cursive approximation of "Neha Fogla" signature
  // Using bezier curves to mimic the loops and flow visible in the scan
  const curves = [
    // large upper loop (N/first letter)
    { type: 'b', pts: [x+2,y+2, x+4,y-4, x+8,y-6, x+10,y+2] },
    { type: 'b', pts: [x+10,y+2, x+12,y+8, x+10,y+10, x+8,y+8] },
    { type: 'b', pts: [x+8,y+8, x+6,y+4, x+10,y+0, x+16,y-2] },
    // middle flow
    { type: 'b', pts: [x+16,y-2, x+20,y-4, x+22,y+0, x+20,y+4] },
    { type: 'b', pts: [x+20,y+4, x+18,y+8, x+20,y+10, x+24,y+8] },
    // lower tail / underliner
    { type: 'b', pts: [x+24,y+8, x+28,y+6, x+30,y+10, x+26,y+14] },
    { type: 'l', pts: [x+26,y+14, x+4,y+14] },
  ];

  curves.forEach(c => {
    if (c.type === 'b') {
      const [x1,y1,x2,y2,x3,y3,x4,y4] = c.pts;
      doc.lines([[x2-x1, y2-y1, x3-x1, y3-y1, x4-x1, y4-y1]], x1, y1, [1,1], 'S', false);
    } else {
      doc.line(c.pts[0], c.pts[1], c.pts[2], c.pts[3]);
    }
  });
}

// ── Toast ───────────────────────────────────────────────────
function showToast() {
  const t = document.getElementById('toast');
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}
</script>
</body>
</html>
